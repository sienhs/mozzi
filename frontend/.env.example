# Public build-time configuration. Never put OAuth client secrets or tokens here.
EXPO_PUBLIC_API_URL=https://k15d102.p.ssafy.io/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Terms versions are not configured here: each bundled body in assets/legal/ carries its
# version, and sign-up is allowed only when it matches GET /meta termsVersions.
# Where the update prompt sends members (https only). The store/distribution link is not
# decided yet; when blank the prompt explains the update without a link.
EXPO_PUBLIC_APP_UPDATE_URL=
