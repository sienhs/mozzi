{
  "name": "mozzi",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test -- --runInBand",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/nanum-pen-script": "^0.4.0",
    "@expo-google-fonts/noto-sans-kr": "^0.4.4",
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.59.0",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "expo-doctor": "^1.21.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "tailwindcss": "3.4.17",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "\\.css$": "<rootDir>/jest.style-mock.js",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
