@baseUrl = http://localhost:8080/api/v1
# Every request needs an access token: take accessToken from POST /auth/google (existing
# member) or POST /auth/signup (new member). See auth.http.
@accessToken = paste-access-token-here

# Emoticons and base icons are registered by the server outside the migrations; insert a few
# rows into emoticon and icon locally before trying the requests below.

### Emoticons, one per emotion
GET {{baseUrl}}/emoticons
Authorization: Bearer {{accessToken}}

### Base images to make icons from
GET {{baseUrl}}/icons
Authorization: Bearer {{accessToken}}

### Make an icon. Expect 201; 409 once the category already has nine.
POST {{baseUrl}}/my-icons
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "iconId": 1, "name": "요리", "category": "WHAT" }

### My icons in one category, oldest first
GET {{baseUrl}}/my-icons?category=WHAT
Authorization: Bearer {{accessToken}}

### Delete an icon. Expect 204; it disappears from old diaries too.
DELETE {{baseUrl}}/my-icons/1
Authorization: Bearer {{accessToken}}

### Write today's diary. myIconIds needs at least one WHAT icon. Expect 201.
POST {{baseUrl}}/diaries
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{$uuid}}
Content-Type: application/json

{
  "emoticonId": 2,
  "content": "퇴근하고 오므라이스를 만들어 먹었어",
  "myIconIds": [1]
}

### Request the picture. Expect 202 with imageStatus PENDING.
POST {{baseUrl}}/diaries/1/image
Authorization: Bearer {{accessToken}}
Idempotency-Key: {{$uuid}}
Content-Type: application/json

{ "characterId": 1, "timeOfDay": "EVENING", "weather": "RAINY", "whatMyIconId": 1 }

### One day
GET {{baseUrl}}/diaries/daily?date=2026-10-28
Authorization: Bearer {{accessToken}}

### Calendar month
GET {{baseUrl}}/diaries/monthly?yearMonth=2026-10
Authorization: Bearer {{accessToken}}

### List, newest first, with optional filters
GET {{baseUrl}}/diaries?size=20&emotion=CALM&from=2026-10-01&to=2026-10-31
Authorization: Bearer {{accessToken}}
