# Reference values: configure these in IntelliJ's Environment variables field
# or in the server's runtime environment.
# Spring Boot does not automatically load this file.

# One of: local | prod
# Required when running the packaged jar (java -jar). IDE runs default to local.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Database. The local profile already defaults to the container in backend/compose.yaml,
# so these only need setting to point somewhere else:
#   cd backend && docker compose up -d
# The prod profile has no defaults on purpose -- a missing value must stop the server
# rather than silently point it at a developer database.
DB_URL=jdbc:postgresql://localhost:5432/mozzi
DB_USERNAME=mozzi
DB_PASSWORD=mozzi

# Auth. The local profile has defaults for both; prod has none and refuses to start without.
# HS256 key for access tokens, at least 32 bytes: openssl rand -base64 48
AUTH_JWT_SECRET=
# The server's Web OAuth client id from Google Cloud Console (comma-separated if several).
GOOGLE_CLIENT_IDS=

# SSAFY GMS key: emotion search (chat model and embeddings) and translating picture inputs
# share it. The local profile starts without it, but emotion search answers 503 until it is
# set and pictures go out untranslated (MOZZI_IMAGE_TRANSLATE=true to translate locally);
# prod refuses to start.
GMS_API_KEY=
MOZZI_IMAGE_TRANSLATE=

# Picture diary queues. Optional locally: without them requests are only logged. prod
# refuses to start without both. From `terraform output -json ai_queues`; AWS credentials
# come from the EC2 instance role.
SQS_AI_REQUEST_QUEUE_URL=
SQS_AI_RESPONSE_QUEUE_URL=
AWS_REGION=ap-northeast-2
# Firebase service account key for push notifications: the JSON file's content on one line,
# not a path. Optional: without it pushes are only logged. It can push to every user, so
# keep it out of the repository.
FIREBASE_SERVICE_ACCOUNT_JSON=
# The character every picture uses until the character table exists. Optional everywhere.
# The prompt is English and is sent untranslated.
MOZZI_DEFAULT_CHARACTER_IMAGE_URL=
MOZZI_DEFAULT_CHARACTER_PROMPT=
