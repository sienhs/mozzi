# ai/.env.example → ai/.env 로 복사해서 채운다. .env 는 절대 커밋하지 않는다.

# TODO({{IMAGE_API_PROVIDER}}) 후보 생성/ api_ref 비교에 쓸 외부 이미지 API 이름
IMAGE_API_PROVIDER=
IMAGE_API_KEY=
# 장당 비용 (USD). generation_log.jsonl 과 inference_summary 의 비용 계산에 사용
IMAGE_API_COST_PER_IMAGE_USD=0

# provider 구현 선택: external_api | klein_local | dry_run
IMAGE_PROVIDER_IMPL=external_api

# (선택) Hugging Face 토큰. 현재 쓰는 모델은 전부 gated 가 아니라 없어도 된다.
HF_TOKEN=
# (선택) 모델 캐시 위치를 바꾸고 싶을 때. 기본: %USERPROFILE%\.cache\huggingface
# HF_HOME=D:\hf_cache
