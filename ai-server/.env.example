# cp .env.example .env 후 값을 채운다. .env 는 커밋하지 않는다.
# GPU 서버용 IAM 사용자 키 (권한: 요청 큐 받기·삭제·visibility 변경, 결과 큐 보내기, S3 PutObject)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

REQUEST_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/000000000000/mochi-image-request
RESULT_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/000000000000/mochi-image-result
S3_BUCKET=
# 결과 imageUrl 의 앞부분 (CloudFront 등). 비우면 https://{S3_BUCKET}.s3.{AWS_REGION}.amazonaws.com
IMAGE_BASE_URL=

# 모델은 HF 캐시에서만 읽는다 (check_env.py --download 로 미리 받아 둔다)
HF_HUB_OFFLINE=1
