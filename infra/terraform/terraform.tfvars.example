ssh_key_name            = "personal-seoul"
wireguard_allowed_cidrs = ["198.51.100.20/32"]
# Pinned to the current Ubuntu AMI in Seoul; change only for a planned replacement.
worker_ami_id          = "ami-05b2d28c4a1614552"
# Optional overrides (defaults: t3.small, 30 GiB).
# worker_instance_type    = "t3.small"
# worker_root_volume_size = 30
# availability_zone_id    = "apne2-az1"
# gateway_instance_type   = "t3.micro"
# aws_account_id          = "123456789012"
# Required: choose your own DB credentials. No credentials are generated or defaulted.
# Supply TF_VAR_db_username and TF_VAR_db_password in your environment,
# or add db_username and db_password to your ignored local terraform.tfvars.
# rds_secondary_availability_zone_id = "apne2-az2"
# SQS visibility timeouts: cover consumer processing time (seconds).
# ai_request_visibility_timeout_seconds  = 900
# ai_response_visibility_timeout_seconds = 60
